{
  "name": "cleanflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e/flow.mjs && node tests/e2e/responsive.mjs && node tests/e2e/integrity.mjs && node tests/e2e/sync.mjs && node tests/e2e/behaviour.mjs && node tests/e2e/coach.mjs && node tests/e2e/sections.mjs && node tests/e2e/meals.mjs && node tests/e2e/movement.mjs && node tests/e2e/learning.mjs && node tests/e2e/assist.mjs",
    "check": "tsc --noEmit && vitest run",
    "build:server": "vite build --ssr server/node.ts --outDir dist-server",
    "start": "node dist-server/node.js",
    "dev:coach": "sh scripts/with-keychain-key.sh npm run dev",
    "sample-data": "vite-node scripts/make-sample-data.ts",
    "storage-growth": "vite-node scripts/storage-growth.ts",
    "cap:sync": "VITE_CLEANFLOW_STANDALONE=1 npm run build && cap sync",
    "test:db": "sh scripts/test-db.sh run vitest run tests/db",
    "db:migrate": "vite-node scripts/migrate.ts",
    "stripe:setup": "vite-node scripts/stripe-setup.ts",
    "e2e:standalone": "node tests/e2e/standalone.mjs",
    "e2e:plans": "sh scripts/test-db.sh run node tests/e2e/plans.mjs",
    "e2e:accounts": "sh scripts/test-db.sh run node tests/e2e/accounts.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capgo/capacitor-health": "^8.11.12",
    "better-auth": "^1.7.10",
    "lucide-react": "^0.460.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.8"
  }
}
