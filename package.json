{
  "name": "cleanflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e/flow.mjs && node tests/e2e/responsive.mjs && node tests/e2e/integrity.mjs && node tests/e2e/sync.mjs && node tests/e2e/behaviour.mjs && node tests/e2e/coach.mjs && node tests/e2e/sections.mjs",
    "check": "tsc --noEmit && vitest run",
    "build:server": "vite build --ssr server/node.ts --outDir dist-server",
    "start": "node dist-server/node.js",
    "dev:coach": "sh scripts/with-keychain-key.sh npm run dev",
    "sample-data": "vite-node scripts/make-sample-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.8"
  }
}
